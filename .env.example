# Empires Online — plantilla de configuración.
#
# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore:
# NUNCA se versionan secretos. Referencia completa: docs/operations/configuration.md
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env

# ─────────────────────────────────────────────────────────────
# Entorno y observabilidad
# ─────────────────────────────────────────────────────────────
EO_ENV=development
EO_LOG_LEVEL=debug
EO_HTTP_ADDR=:8080
EO_METRICS_ADDR=:9090

# ─────────────────────────────────────────────────────────────
# Infraestructura (SECRETOS en producción)
# ─────────────────────────────────────────────────────────────
EO_POSTGRES_URL=postgres://empires:empires_dev_password@localhost:5432/empires?sslmode=disable

# Redis es OPCIONAL en desarrollo. Si se deja vacío, el servidor usa estado
# caliente en proceso (presencia, anti-replay de tickets e idempotencia), que da
# las mismas garantías mientras haya una sola instancia. En producción es
# OBLIGATORIA: un almacén en proceso no se comparte entre instancias y el
# anti-replay dejaría de valer en cuanto hubiera dos.
EO_REDIS_URL=redis://localhost:6379/0

# Secreto compartido entre Next.js (emisor del game ticket) y el Game Server (verificador).
# Genera uno propio con: openssl rand -base64 48
EO_AUTH_JWT_SECRET=dev-only-insecure-secret-change-me-before-any-deployment

# ─────────────────────────────────────────────────────────────
# Simulación
# ─────────────────────────────────────────────────────────────
EO_TICK_RATE_HZ=10
EO_WORLD_WIDTH=512
EO_WORLD_HEIGHT=512
EO_WORLD_SEED=20260909
EO_CHUNK_SIZE=32
EO_INTEREST_RADIUS_CHUNKS=2

# ─────────────────────────────────────────────────────────────
# Presencia y protección offline (valores de gameplay: nunca hardcodear)
# ─────────────────────────────────────────────────────────────
EO_PRESENCE_TTL_SECONDS=30
EO_PRESENCE_HEARTBEAT_SECONDS=10
EO_CITY_OFFLINE_PROTECTION_COOLDOWN_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Persistencia
# ─────────────────────────────────────────────────────────────
EO_PERSISTENCE_FLUSH_INTERVAL_TICKS=50

# ¿Migrar el esquema al arrancar el servidor?
# Por defecto: true en desarrollo, false en producción. En producción se usa el
# binario `migrate` como paso previo del despliegue, porque varias instancias
# arrancando a la vez competirían por el mismo esquema.
EO_MIGRATE_ON_START=true

# ─────────────────────────────────────────────────────────────
# Pathfinding
# ─────────────────────────────────────────────────────────────
EO_PATHFINDING_MAX_NODES=20000
EO_PATHFINDING_MAX_DISTANCE=256

# ─────────────────────────────────────────────────────────────
# WebSocket
# ─────────────────────────────────────────────────────────────
EO_WS_MAX_MESSAGE_BYTES=16384
EO_WS_RATE_LIMIT_PER_SECOND=20
EO_WS_RATE_LIMIT_BURST=40

# ─────────────────────────────────────────────────────────────
# Identidad: alta, login y sesión web. Las lee el servidor de Next.js (ADR-018);
# el Game Server ya no ve contraseñas.
# ─────────────────────────────────────────────────────────────

# Almacén de identidad de apps/web: su propia base, separada del esquema del
# juego y con su propio rol. En local la crea `pnpm run pg:identity`, que
# genera la contraseña del rol al azar y escribe esta URL en tu .env: no la
# copies aquí. EO_TEST_IDENTITY_POSTGRES_URL es la base de sus tests (_test).
EO_IDENTITY_POSTGRES_URL=
EO_TEST_IDENTITY_POSTGRES_URL=

# Dónde alcanza Next.js al Game Server para fundar a un jugador recién dado de
# alta (POST /internal/players, autenticado con un token firmado con
# EO_AUTH_JWT_SECRET y audiencia game-server-internal).
EO_GAME_SERVER_INTERNAL_URL=http://localhost:8080

# Límites de tasa del alta y el login (por proceso de Next.js). Cada intento
# calcula scrypt: sin límite, cualquiera hace quemar CPU al servidor web, y en el
# login es además lo único que separa una contraseña de la fuerza bruta. Tres
# cubos, porque ninguno basta solo (docs/specs/player.md §4.1):
#
#   - Por IP: sólo se conoce detrás de un proxy de confianza (ver más abajo).
EO_AUTH_RATE_LIMIT_PER_MINUTE=10
EO_AUTH_RATE_LIMIT_BURST=5
#   - Por nombre de usuario, venga de donde venga: frena la fuerza bruta
#     repartida entre muchas direcciones y funciona sin proxy.
EO_AUTH_RATE_LIMIT_USER_PER_MINUTE=20
EO_AUTH_RATE_LIMIT_USER_BURST=10
#   - Global: tope absoluto del coste de scrypt del proceso. Más amplio que el de
#     una IP porque lo comparten todos; sin proxy, es lo que acota a un solo
#     cliente. Debe ser al menos tan amplio como los dos anteriores.
EO_AUTH_RATE_LIMIT_GLOBAL_PER_MINUTE=120
EO_AUTH_RATE_LIMIT_GLOBAL_BURST=30

# Tope global del ticket y el cierre de sesión, que no calculan scrypt pero sí
# consultan la base. Un cliente que reconecta pide un ticket por intento (hasta
# siete en su primer minuto): 600 de ráfaga absorben la reconexión de un centenar
# de jugadores tras un reinicio. Los cupos por sesión y por IP son constantes.
EO_AUTH_TICKET_RATE_LIMIT_PER_MINUTE=1200
EO_AUTH_TICKET_RATE_LIMIT_BURST=600

# Confiar en las cabeceras del proxy (X-Forwarded-For, y X-Real-IP a falta de
# ella) para conocer la IP del cliente.
#
# Ponlo a true SOLO si hay un proxy inverso delante (Caddy, nginx, Vercel). Sin
# proxy y con esto, cualquiera falsifica la cabecera. Sin esto no hay cupo por
# IP: el global y el de usuario siguen protegiendo. El valor por defecto es el
# seguro.
EO_TRUST_PROXY_HEADERS=false

# Cuántos proxies de confianza añaden su salto a X-Forwarded-For. La IP del
# cliente es el N-ésimo elemento por la DERECHA de la lista: el primero lo
# escribe quien quiera. Con un solo proxy (lo normal), 1. Si declaras más de los
# que hay, un atacante elige la IP que se le atribuye.
EO_TRUSTED_PROXY_COUNT=1

# ─────────────────────────────────────────────────────────────
# Frontend (Next.js) — las variables NEXT_PUBLIC_* son visibles en el navegador.
# Jamás pongas aquí credenciales de PostgreSQL, Redis ni el secreto JWT.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GAME_SERVER_WS_URL=ws://localhost:8080/ws
